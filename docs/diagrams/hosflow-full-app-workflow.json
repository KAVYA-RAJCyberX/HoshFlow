    { "from": "tpa_claim", "to": "copay", "role": "error", "label": "shortfall" },
    { "from": "tpa_claim", "to": "clear_payment", "label": "cashless" },
    { "from": "copay", "to": "clear_payment", "label": "receipt" },
    
    { "from": "governance", "to": "global_ops", "role": "async" },
    { "from": "global_ops", "to": "exec_dash", "role": "async" },

    { "from": "clear_payment", "to": "gate_pass" },
    { "from": "gate_pass", "to": "leave" },
    { "from": "leave", "to": "turnover", "route": "outside-right" },
    { "from": "turnover", "to": "exec_dash", "route": "outside-right" }
