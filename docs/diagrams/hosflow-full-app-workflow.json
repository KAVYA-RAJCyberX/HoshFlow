    { "id": "consult", "lane": "clinical", "col": 1, "type": "frontend", "label": "Consult & Orders", "sublabel": "Clinical Station", "width": 124 },
    { "id": "inventory", "lane": "pharmacy", "col": 1, "type": "database", "label": "Check Inventory", "sublabel": "Pharmacy Stat", "width": 124 },

    { "id": "dispense", "lane": "pharmacy", "col": 2, "type": "backend", "label": "Dispense & Labs", "sublabel": "LIS & Pharmacy", "width": 124 },
