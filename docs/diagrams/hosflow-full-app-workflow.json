  "cards": [
    { "dot": "cyan", "title": "Comprehensive View Mapping", "items": ["This diagram captures every module in Hosflow from Patient Portal to Executive Analytics."] },
    { "dot": "emerald", "title": "Real-time Operations", "items": ["Global Operations and System Governance listen to billing/discharge events asynchronously."] }
